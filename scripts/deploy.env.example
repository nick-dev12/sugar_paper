# Copier sur le VPS (hors dépôt git) :
#   cp scripts/deploy.env.example /home/jomas/deploy-samapiece.env
#   nano /home/jomas/deploy-samapiece.env

# Chemin du site en production
DEPLOY_DIR=/home/jomas/samapiece.com

# Branche GitHub à déployer
GIT_BRANCH=main

# Remote Git
GIT_REMOTE=origin
GIT_REPO=https://github.com/nick-dev12/sugar_paper.git

# Composer (laisser vide pour auto-détection)
COMPOSER_BIN=

# Node / PM2 (suivi GPS)
NODE_BIN=
NPM_BIN=
PM2_BIN=
PM2_APP_NAME=sugar-tracking
RESTART_TRACKING=1
TRACKING_DIR=tracking-server

# Migrations PHP optionnelles (1 = exécuter scripts/deploy-migrations.list)
RUN_MIGRATIONS=0

# Utilisateur propriétaire des fichiers Webuzo
WEB_USER=jomas
WEB_GROUP=jomas

# Log déploiement
DEPLOY_LOG=/home/jomas/logs/deploy-samapiece.log
