# Copiez ce fichier en .env sur le VPS et renseignez les valeurs.
# Le secret doit être IDENTIQUE à config/tracking.php (internal_secret).

TRACKING_PORT=3001
TRACKING_SOCKET_PATH=/socket.io

# URL locale Apache/PHP (port Webuzo : souvent 8081 ou 8082, pas 80)
TRACKING_PHP_BASE=http://127.0.0.1:8081

# VirtualHost Apache (obligatoire sur Webuzo multi-domaines)
TRACKING_PHP_HOST=samapiece.com

# Secret partagé PHP ↔ Node (longue chaîne aléatoire)
TRACKING_INTERNAL_SECRET=REMPLACEZ_PAR_LA_MEME_CLE_QUE_config_tracking_php

# Origines CORS autorisées (séparées par des virgules)
TRACKING_CORS_ORIGINS=https://sugar-paper.com,https://www.sugar-paper.com
