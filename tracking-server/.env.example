# Copiez ce fichier en .env sur le VPS : cp .env.example .env
# Le secret doit être IDENTIQUE à config/tracking.php (internal_secret).

TRACKING_PORT=3001
TRACKING_SOCKET_PATH=/socket.io

# Webuzo samapiece.com — Apache HTTP interne (pas 80, pas 8082 SSL)
TRACKING_PHP_BASE=http://127.0.0.1:8081
TRACKING_PHP_HOST=samapiece.com

# Secret partagé PHP ↔ Node (openssl rand -hex 32)
TRACKING_INTERNAL_SECRET=REMPLACEZ_PAR_LA_MEME_CLE_QUE_config_tracking_php

# Origines CORS (sans slash final)
TRACKING_CORS_ORIGINS=https://samapiece.com,https://www.samapiece.com

# --- Développement local (WAMP) : décommentez et adaptez ---
# TRACKING_PHP_BASE=http://127.0.0.1
# TRACKING_PHP_HOST=
